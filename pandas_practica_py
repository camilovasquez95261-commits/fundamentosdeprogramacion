import pandas as pd

ruta = "https://github.com/VMjavier/BootcampIA/raw/refs/heads/main/mascotas_limpio%20(1).csv"

df = pd.read_csv(ruta)
df.head(3)#

import matplotlib.pyplot as plt
import pandas as pd

# Obtener los datos de especie
conteo_especies = df['especie'].value_counts()
etiquetas = conteo_especies.index.tolist() # ['Perro', 'Gato']
valores = conteo_especies.values.tolist() # [2, 1] (según tus datos)

# Versión adaptada para especie
plt.figure(figsize=(8, 5))
barras = plt.bar(
    etiquetas, # Eje x (especies)
    valores, # Eje y (conteos)
    width=0.6, # Ancho de las barras
    color='#132440', # Color de las barras
    edgecolor='#16476A', # Borde de las barras
    linewidth=1.5, # Grosor del borde
    align='center', # Alineación
    alpha=0.8, # Transparencia
    hatch='/', # Patrón
    zorder=3 # Orden en el eje Z
)

# Añadir etiquetas de valores sobre las barras
for barra in barras:
    altura = barra.get_height()
    plt.text(barra.get_x() + barra.get_width()/2., altura + 0.1,
             f'{int(altura)}',
             ha='center', va='bottom',
             fontsize=11, weight='bold')

# Estilizar ejes y fondo
plt.title('Distribución de Especies', fontsize=14, weight='bold', pad=20)
plt.xlabel('Especies', fontsize=12)
plt.ylabel('Cantidad de Mascotas', fontsize=12)
plt.grid(True, axis='y', linestyle='--', alpha=0.7, zorder=0)
plt.ylim(0, max(valores) + 0.5) # Un poco más alto para las etiquetas
plt.xticks(fontsize=11)
plt.yticks(fontsize=11)
plt.gca().set_facecolor('#f5f5f5') # Color del fondo del área del gráfico

# Opcional: Añadir un borde al gráfico
plt.gca().spines['top'].set_visible(False)
plt.gca().spines['right'].set_visible(False)

plt.tight_layout()
plt.show()

